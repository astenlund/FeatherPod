{
  "version": "2.0",
  "functionTimeout": "01:00:00",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function": "Information",
      "FeatherPod": "Debug",
      "Azure.Core": "Error",
      "Azure.Storage": "Error"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "queues": {
      "maxPollingInterval": "00:00:05",
      "visibilityTimeout": "01:00:00",
      "batchSize": 1,
      "maxDequeueCount": 3,
      "newBatchThreshold": 0,
      "messageEncoding": "none"
    }
  }
}
